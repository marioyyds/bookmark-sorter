{
  "manifest_version": 3,
  "name": "个人知识库",
  "version": "3.0.0",
  "description": "个人知识库 + RecallFlow：收录算法错题、技术文章、AI 工具与 Prompt、手动笔记，支持划词问答、翻译、解释与基于知识库的 RAG 检索问答。",
  "permissions": ["tabs", "storage", "contextMenus"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "个人知识库",
    "default_icon": {
      "16": "icons/recallflow-mark.svg",
      "32": "icons/recallflow-mark.svg",
      "48": "icons/recallflow-mark.svg",
      "128": "icons/recallflow-mark.svg"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/recallflow-mark.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/recallflow-mark.svg",
    "32": "icons/recallflow-mark.svg",
    "48": "icons/recallflow-mark.svg",
    "128": "icons/recallflow-mark.svg"
  }
}
