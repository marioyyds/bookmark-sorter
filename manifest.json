{
  "manifest_version": 3,
  "name": "个人知识库",
  "version": "2.0.0",
  "description": "个人知识库：收录算法错题、技术文章、AI 工具与 Prompt、手动笔记，支持类型分类、标签、星级与全文搜索。",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "个人知识库",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
